# Autotask API credentials (required)
AUTOTASK_USERNAME=
AUTOTASK_SECRET=
AUTOTASK_INTEGRATION_CODE=
# AUTOTASK_API_URL=            # optional; auto-detected by zone if unset

# --- Transport (HTTP deployments) ---
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=8080
# AUTH_MODE=env                # env | gateway

# --- Impersonation & caller-container attribution (see docs/DEPLOYMENT.md) ---
# AUTOTASK_IMPERSONATION_MODE=off        # off | caller | gateway (per instance)
# AUTOTASK_IMPERSONATION_SOURCES=        # caller mode: comma-list allowlist, e.g. chatgpt,hermes-teams
# MCP_INSTANCE_LABEL=                     # this container's audit label, e.g. gpt-teams / n8n-cron
